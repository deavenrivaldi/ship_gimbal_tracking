              <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
            </inertial>
          </link>

          <joint name="right_chasis_engine_joint" type="revolute">
            <axis>
              <xyz>0 0 1</xyz>
              <limit><lower>-1.57</lower><upper>1.57</upper><effort>50</effort><velocity>10</velocity></limit>
            </axis>
