<?xml version="1.0" ?>

<sdf version="1.9">
 



      <model name="capstone_boat">
      <static>false</static>
        <link name="capstone_link">
          <enable_wind>true</enable_wind>
          <pose>5 0 0 0 0 0</pose>
          <inertial>
            <mass>15.0</mass>
            <pose>0 0.2 -0.1 0 0 0</pose>
            <inertia>
              <ixx>2.0</ixx>  <!-- 俯仰 (Pitch) -->
              <ixy>0.0</ixy>
              <ixz>0.0</ixz>
              <iyy>0.4</iyy>  <!-- 側翻 (Roll) -->
              <iyz>0.0</iyz>
              <izz>2.3</izz>  <!-- 偏航 (Yaw) -->
            </inertia>
          </inertial>

          <visual name="capstone_visual">
            <geometry>
              <mesh><uri>capstone_boat/Assembly 1.dae</uri></mesh>
            </geometry>
          </visual>
                    <!-- Top base -->


