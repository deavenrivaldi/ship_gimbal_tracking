          </points>
          
          <fluid_level>0</fluid_level>
          <wavefield>
            <topic>/gazebo/wavefield/parameters</topic>
          </wavefield>
        </plugin>
        <plugin
            filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
            <link_name>capstone_link</link_name>
            
            <xDotU>0.0</xDotU>
            <yDotV>0.0</yDotV>
            <nDotR>0.0</nDotR>
            
            <!-- 大幅調低線性阻尼 -->
            <xU>-1.0</xU>     
            <yV>-2.5</yV>     
            <zW>-10.0</zW>     
            <kP>-2.0</kP>     
            <mQ>-2.0</mQ>     
            <nR>-1.5</nR>     
            
            <!-- 大幅調低二次阻尼 -->
            <xAbsU>-1.5</xAbsU> 
            <yAbsV>-3.5</yAbsV> 
            <nAbsR>-2.5</nAbsR> 
          </plugin>




<link name="left_engine_link">
            <pose>4.81 0.45 -0.02 0 0 0</pose>
            <visual name="left_engine_visual">
              <geometry><box><size>0.05 0.1 0.1</size></box></geometry>
              <material><ambient>0.2 0.2 0.2 1</ambient></material>
            </visual>
            <collision name="left_engine_collision">
              <geometry><box><size>0.05 0.1 0.1</size></box></geometry>
            </collision>
            <inertial>
              <mass>1.0</mass>
              <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
            </inertial>
          </link>

          <link name="left_propeller_link">
            <pose>4.81 0.48 -0.06 0 0 0</pose>
            <visual name="left_propeller_visual">
              <pose>0 0 0 1.5708 0 0</pose> 
              <geometry><cylinder><length>0.04</length><radius>0.06</radius></cylinder></geometry>
              <material><ambient>0.8 0.8 0.1 1</ambient></material>
            </visual>
            <collision name="left_propeller_collision">
              <pose>0 0 0 1.5708 0 0</pose>
              <geometry><cylinder><length>0.04</length><radius>0.06</radius></cylinder></geometry>
            </collision>
            <inertial>
              <mass>0.2</mass>
              <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
            </inertial>
          </link>

          <joint name="left_chasis_engine_joint" type="revolute">
            <axis>
              <xyz>0 0 1</xyz> <limit><lower>-1.57</lower><upper>1.57</upper><effort>50</effort><velocity>10</velocity></limit>
            </axis>
            <parent>capstone_link</parent>
            <child>left_engine_link</child>
          </joint>

          <joint name="left_engine_propeller_joint" type="revolute">
            <axis>
              <xyz>0 1 0</xyz> <limit><effort>100</effort><velocity>100</velocity></limit>
              <dynamics><friction>0.05</friction><damping>0.05</damping></dynamics>
            </axis>
            <parent>left_engine_link</parent>
            <child>left_propeller_link</child>
          </joint>

          <link name="right_engine_link">
            <pose>5.19 0.45 -0.02 0 0 0</pose>
            <visual name="right_engine_visual">
              <geometry><box><size>0.05 0.1 0.1</size></box></geometry>
              <material><ambient>0.2 0.2 0.2 1</ambient></material>
            </visual>
            <collision name="right_engine_collision">
              <geometry><box><size>0.05 0.1 0.1</size></box></geometry>
            </collision>
            <inertial>
              <mass>1.0</mass>
              <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
            </inertial>
          </link>

          <link name="right_propeller_link">
            <pose>5.19 0.48 -0.06 0 0 0</pose>
            <visual name="right_propeller_visual">
              <pose>0 0 0 1.5708 0 0</pose>
              <geometry><cylinder><length>0.04</length><radius>0.06</radius></cylinder></geometry>
              <material><ambient>0.8 0.8 0.1 1</ambient></material>
            </visual>
            <collision name="right_propeller_collision">
              <pose>0 0 0 1.5708 0 0</pose>
              <geometry><cylinder><length>0.04</length><radius>0.06</radius></cylinder></geometry>
            </collision>
            <inertial>
              <mass>0.2</mass>
              <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
            </inertial>
          </link>

          <joint name="right_chasis_engine_joint" type="revolute">
            <axis>
              <xyz>0 0 1</xyz>
              <limit><lower>-1.57</lower><upper>1.57</upper><effort>50</effort><velocity>10</velocity></limit>
            </axis>
            <parent>capstone_link</parent>
            <child>right_engine_link</child>
          </joint>

          <joint name="right_engine_propeller_joint" type="revolute">
            <axis>
              <xyz>0 1 0</xyz>
              <limit><effort>100</effort><velocity>100</velocity></limit>
              <dynamics><friction>0.05</friction><damping>0.05</damping></dynamics>
            </axis>
            <parent>right_engine_link</parent>
            <child>right_propeller_link</child>
          </joint>

          <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
            <joint_name>left_engine_propeller_joint</joint_name>
            <thrust_coefficient>0.004422</thrust_coefficient>
            <fluid_density>1000</fluid_density>
            <propeller_diameter>0.12</propeller_diameter>
            <velocity_control>true</velocity_control>
            </plugin>

          <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>left_chasis_engine_joint</joint_name>
            <use_velocity_commands>true</use_velocity_commands>
            <topic>/capstone_boat/left/steering/cmd_pos</topic>
          </plugin>

          <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
            <joint_name>right_engine_propeller_joint</joint_name>
            <thrust_coefficient>0.004422</thrust_coefficient>
            <fluid_density>1000</fluid_density>
            <propeller_diameter>0.12</propeller_diameter>
            <velocity_control>true</velocity_control>
            </plugin>

          <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>right_chasis_engine_joint</joint_name>
            <use_velocity_commands>true</use_velocity_commands>
            <topic>/capstone_boat/right/steering/cmd_pos</topic>
          </plugin>

          <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
          <publish_link_pose>false</publish_link_pose>
          <publish_model_pose>true</publish_model_pose>
          <update_frequency>10</update_frequency> 
          </plugin>

          <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
          </plugin>

    </model>
</sdf>
