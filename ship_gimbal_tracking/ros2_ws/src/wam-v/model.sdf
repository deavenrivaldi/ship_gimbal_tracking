        <plugin
            filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
            <link_name>capstone_link</link_name>
            
            <xDotU>0.0</xDotU>
            <yDotV>0.0</yDotV>
            <nDotR>0.0</nDotR>
            
            <!-- 大幅調低線性阻尼 -->
            <xU>-1.0</xU>     
            <yV>-2.5</yV>     
            <zW>-10.0</zW>     
            <kP>-2.0</kP>     
            <mQ>-2.0</mQ>     
            <nR>-1.5</nR>     
            
            <!-- 大幅調低二次阻尼 -->
            <xAbsU>-1.5</xAbsU> 
            <yAbsV>-3.5</yAbsV> 
            <nAbsR>-2.5</nAbsR> 
          </plugin>




<link name="left_engine_link">
            <pose>4.81 0.45 -0.02 0 0 0</pose>
            <visual name="left_engine_visual">
              <geometry><box><size>0.05 0.1 0.1</size></box></geometry>
              <material><ambient>0.2 0.2 0.2 1</ambient></material>
            </visual>
            <collision name="left_engine_collision">
              <geometry><box><size>0.05 0.1 0.1</size></box></geometry>
            </collision>
            <inertial>
              <mass>1.0</mass>
              <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
            </inertial>
          </link>

          <link name="left_propeller_link">
            <pose>4.81 0.48 -0.06 0 0 0</pose>
            <visual name="left_propeller_visual">
              <pose>0 0 0 1.5708 0 0</pose> 
              <geometry><cylinder><length>0.04</length><radius>0.06</radius></cylinder></geometry>
              <material><ambient>0.8 0.8 0.1 1</ambient></material>
            </visual>
            <collision name="left_propeller_collision">
