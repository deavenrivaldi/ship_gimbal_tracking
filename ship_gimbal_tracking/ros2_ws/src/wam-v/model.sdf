        <plugin
          filename="libSurface.so"
          name="maritime::Surface">
          <link_name>capstone_link</link_name>
          <fluid_density>1000</fluid_density>
          

            <points>
            <!-- ========================================== -->
            <!--                 側邊船體 A (左舷)            -->
            <!-- ========================================== -->

        <!-- 1. 初始點位 (船身中段基礎) -->
