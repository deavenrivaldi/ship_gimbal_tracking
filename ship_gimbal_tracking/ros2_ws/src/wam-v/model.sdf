<?xml version="1.0" ?>

<sdf version="1.9">
 



      <model name="capstone_boat">
      <static>false</static>
        <link name="capstone_link">
          <enable_wind>true</enable_wind>
          <pose>5 0 0 0 0 0</pose>
          <inertial>
            <mass>15.0</mass>
            <pose>0 0.2 -0.1 0 0 0</pose>
            <inertia>
              <ixx>2.0</ixx>  <!-- 俯仰 (Pitch) -->
              <ixy>0.0</ixy>
              <ixz>0.0</ixz>
              <iyy>0.4</iyy>  <!-- 側翻 (Roll) -->
              <iyz>0.0</iyz>
              <izz>2.3</izz>  <!-- 偏航 (Yaw) -->
            </inertia>
          </inertial>

          <sensor name="imu_sensor" type="imu">
              <always_on>1</always_on>
              <update_rate>100</update_rate> <!-- 建議提高頻率，例如 100 Hz -->
              <visualize>true</visualize>
              <topic>imu</topic>
              
              <!-- 加入這個 Plugin 才能把數值回傳給 ROS 2 -->
              <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
                  <ros>
                      <namespace>/</namespace>
                      <!-- 這裡設定你要回傳數值的 Topic 名稱 -->
                      <remapping>~/out:=imu_data</remapping>
                  </ros>
                  <initial_orientation_as_reference>false</initial_orientation_as_reference>
              </plugin>
          </sensor>

          <visual name="capstone_visual">
            <geometry>
              <mesh><uri>capstone_boat/Assembly 1.dae</uri></mesh>
            </geometry>
          </visual>

          <!-- [新增] 人的模型，當作船的一部分 -->
          <visual name="person_visual">
            <!-- 調整這個 pose 來決定人站在船上的哪個位置 -->
            <pose>0 0 0.95 0 0 3.1416</pose> 
            <geometry>
              <mesh><uri>model://walking_person/meshes/walk.dae</uri></mesh>
            </geometry>
          </visual>
                    <!-- Top base -->


        <visual name="buoy_vis_L01">
