<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.6">
  <model name="three_axis_gimbal">
    <!-- base link -->
    <link name="gimbal_mount_link">
      <inertial>
        <mass>1</mass>
        <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
      </inertial>
      <visual name="v"><geometry><box><size>0.5 0.5 0.1</size></box></geometry></visual>
      <collision name="c"><geometry><box><size>0.5 0.5 0.1</size></box></geometry></collision>

      <!-- IMU sensor - mounted on gimbal base -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>/imu/data</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <!-- y raw link -->
    <link name="yaw_link">
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
      </inertial>
      <pose>0 0 0.1 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
      </visual>
      <!-- gray round  -->
      <visual name="yaw_support_H">
        <pose>0 0.25 0 1.57 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.62</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- gray round  -->
      <visual name="yaw_support_V">
        <pose>0 0.6 0.45 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.96</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- gray round  -->
      <visual name="yaw_support_round">
        <pose>0 0.6 0.9 1.57 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <!-- joint y-raw to base -->
    <joint name="yaw_joint" type="revolute">
      <parent>gimbal_mount_link</parent>
      <child>yaw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>50</effort><velocity>3</velocity></limit>

        <dynamics>
          <damping>0.2</damping>
          <friction>0.1</friction>
        </dynamics>

      </axis>
    </joint>
    <!-- z-row link -->
    <link name="pitch_link">
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
      </inertial>
      <pose>0 0 1 0 0 0</pose>
      <visual name="v"><pose>0 0.5 0 0 0 0</pose><geometry><box><size>0.3 0.1 0.3</size></box></geometry></visual>
      <!-- gray round  -->
      <visual name="pitch_support_H">
        <pose>-0.25 0.5 0 0 1.57 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.76</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- gray round  -->
      <visual name="pitch_support_V">
        <pose>-0.6 0.25 0 1.57 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.56</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- gray round  -->
      <visual name="yaw_support_round">
        <pose>-0.6 0 0 0 1.57 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <!-- joint z-row to y-row -->
    <joint name="pitch_joint" type="revolute">
      <parent>yaw_link</parent>
      <child>pitch_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>50</effort><velocity>2</velocity></limit>

        <dynamics>
          <damping>0.2</damping>
          <friction>0.1</friction>
        </dynamics>

      </axis>
    </joint>
    <!-- link x-row -->
    <link name="roll_link">
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
      </inertial>
      <pose>0 0 1 0 0 0</pose>
      <visual name="v"><pose>-0.5 0 0 0 0 0</pose><geometry><box><size>0.1 0.3 0.3</size></box></geometry></visual>
      <!-- gray round  -->
      <visual name="roll_support">
        <pose>-0.25 0 0 0 1.57 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.56</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <!-- joint x-row to z-row -->
    <joint name="roll_joint" type="revolute">
      <parent>pitch_link</parent>
      <child>roll_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>50</effort><velocity>2</velocity></limit>

        <dynamics>
          <damping>0.2</damping>
          <friction>0.1</friction>
        </dynamics>

      </axis>
    </joint>
    <!-- link camera -->
    <link name="camera_link">
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
      </inertial>
      <pose>0 0 1 0 0 0</pose>
      <visual name="v"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>

      <!-- Camera sensor -->
      <sensor name="camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>60</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <topic>/camera/image_raw</topic>
      </sensor>
      <sensor name="camera_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <topic>/camera_imu/data_raw</topic>
      </sensor>


    </link>
    <!-- joint camera to x-row -->
    <joint name="camera_joint" type="fixed">
      <parent>roll_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Gimbal joint trajectory controller -->
    <plugin
      filename="gz-sim-joint-trajectory-controller-system"
      name="gz::sim::systems::JointTrajectoryController">
      <topic>/gimbal/joint_trajectory</topic>

      <joint_name>yaw_joint</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>5.0</position_p_gain>
      <position_i_gain>0</position_i_gain>
      <position_d_gain>1.5</position_d_gain>
      <position_i_min>-1.0</position_i_min>
      <position_i_max>1.0</position_i_max>
      <position_cmd_min>-20.0</position_cmd_min>
      <position_cmd_max>20.0</position_cmd_max>

      <joint_name>pitch_joint</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>5.0</position_p_gain>
      <position_i_gain>0</position_i_gain>
      <position_d_gain>1.5</position_d_gain>
      <position_i_min>-1.0</position_i_min>
      <position_i_max>1.0</position_i_max>
      <position_cmd_min>-20.0</position_cmd_min>
      <position_cmd_max>20.0</position_cmd_max>

      <joint_name>roll_joint</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>5.0</position_p_gain>
      <position_i_gain>0</position_i_gain>
      <position_d_gain>1.5</position_d_gain>
      <position_i_min>-1.0</position_i_min>
      <position_i_max>1.0</position_i_max>
      <position_cmd_min>-20.0</position_cmd_min>
      <position_cmd_max>20.0</position_cmd_max>
    </plugin>
  </model>
</sdf>
