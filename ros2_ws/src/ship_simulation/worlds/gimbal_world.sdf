<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="gimbal_world">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
            
    <include>
      <name>Coast Waves</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://coast_waves</uri>
    </include>

    <!-- The wave field -->
    <plugin filename="libPublisherPlugin.so" name="maritime::PublisherPlugin">
      <message type="gz.msgs.Param" topic="/gazebo/wavefield/parameters"
               every="2.0">
        params {
          key: "direction"
          value {
            type: DOUBLE
            double_value: 0.0
          }
        }
        params {
          key: "gain"
          value {
            type: DOUBLE
            double_value: 0.8
            }
        }
        params {
          key: "period"
          value {
            type: DOUBLE
            double_value: 8
          }
        }
        params {
          key: "steepness"
          value {
            type: DOUBLE
            double_value: 0.1
          }
        }
      </message>
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin
        filename="libgz-sim-imu-system.so"
        name="ignition::gazebo::systems::Imu">
    </plugin>


    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>



   

    <include>
      <name>gimbal_wam_v</name>
      <pose>8 0 0 0 0 0</pose>
      <uri>model://wam-v_with_gimbal</uri>
    </include>

    <include>
      <name>wamv</name>
      <pose>15 0 0 0 0 1.57</pose>
      <uri>model://wam-v</uri>
    </include>
    
    
    <!-- projectile system -->
    <!-- <gravity>0 0 -9.81</gravity> -->
    <plugin filename="gz-sim-apply-link-wrench-system"
        name="gz::sim::systems::ApplyLinkWrench">
    </plugin>

    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

  </world>
</sdf>